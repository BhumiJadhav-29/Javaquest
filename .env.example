# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL/Cloud SQL/Neon/Supabase connection string.
# Example: postgresql://username:password@localhost:5432/javaquest
# If omitted, JavaQuest automatically uses an embedded persistent SQLite database in ./data/
DATABASE_URL=

# JWT_SECRET: Secret key for signing and verifying authentication tokens.
JWT_SECRET="javaquest_production_jwt_secret_2026_secure"

# ADMIN_PASSKEY: Secret administrative passkey for administrator clearance.
ADMIN_PASSKEY="ADMIN2026"

# RATE_LIMIT_GENERAL_MAX: Maximum API requests per 15 minutes per IP (Default: 400).
RATE_LIMIT_GENERAL_MAX="400"

# RATE_LIMIT_AUTH_MAX: Maximum auth requests per 15 minutes per IP (Default: 30).
RATE_LIMIT_AUTH_MAX="30"

# RATE_LIMIT_AI_MAX: Maximum Quest AI tutor questions per minute (Default: 30).
RATE_LIMIT_AI_MAX="30"

# RATE_LIMIT_CODE_MAX: Maximum code executions per minute (Default: 45).
RATE_LIMIT_CODE_MAX="45"

# RATE_LIMIT_QUIZ_MAX: Maximum quiz submissions per minute (Default: 30).
RATE_LIMIT_QUIZ_MAX="30"
